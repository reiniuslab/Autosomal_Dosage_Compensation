##

loom2matrix <- function(x){
  require(loomR)
  lfile <- connect(x)
  out <- t(lfile$matrix[,])
  colnames(out) <- lfile$col.attrs$CellID[]
  row.names(out) <- lfile$row.attrs$Gene[]
  lfile$close_all()
  return(out)
}

calculate.refratio <- function(ref, alt, probs=0.9, ... ){
  all <- ref+alt
  idx <- all < quantile(all, probs = probs)
  sum(ref[idx], ... ) / sum(all[idx], ... )
}

fpkm2tpm <- function(x){
  t(t(x)/colSums(x, na.rm=T))*1e6
}

median_cl_boot <- function(x, conf = 0.95) {
  lconf <- (1 - conf)/2
  uconf <- 1 - lconf
  require(boot)
  bmedian <- function(x, ind) median(x[ind])
  bt <- boot(x, bmedian, 1000)
  bb <- boot.ci(bt, type = "perc")
  data.frame(y = median(x), ymin = quantile(bt$t, lconf), ymax = quantile(bt$t, uconf))
}

