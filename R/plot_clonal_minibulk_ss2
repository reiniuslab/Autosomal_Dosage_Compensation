# counts
mat.cnt.mb.p0 <- loom2matrix("out_mRNA/minibulk_SS2_p0/zUMIs_output/expression/minibulk_p0.readcount.exon.all.loom")

dat.qc.mb.p0 <- data.table("Reads" = colSums(mat.cnt.mb.p0), "Genes" = colSums(mat.cnt.mb.p0>0), "Sample_id" = colnames(mat.cnt.mb.p0), "Sample_name" = anno.cell.mb.p0[match(colnames(mat.cnt.mb.p0), Barcode), Sample_name])
