## load data
# annotations
library(rtracklayer)
anno.gene <- import("out_mRNA/minibulk_SS2_p0/minibulk_p0.final_annot.gtf.gz", feature.type = "gene")
anno.cell.mb.p0 <- fread("metadata_index_minibulk_SS2_p0_220607.tsv")

# allelic fraction
mat.frac.mb.p0 <- read.delim("out_mRNA/minibulk_SS2_p0/zUMIs_output/allelic/minibulk_p0.fract_CAST_reads.txt", row.names=1)

mat.frac.mb.p0.melt <- as.data.table(reshape2::melt(as.matrix(mat.frac.mb.p0)))
mat.frac.mb.p0.melt[, det := mean(!is.na(value)), by="Var1"]
mat.frac.mb.p0.melt[as.data.table(anno.gene), c("chrom", "pos", "gene_name") := list(seqnames, start, gene_name), on = "Var1 == gene_id"]

# allelic counts
ls.ae.mb.p0 <- list(
  "c57" = as.matrix(read.delim("out_mRNA/minibulk_SS2_p0/zUMIs_output/allelic/minibulk_p0.BL6_reads.txt", row.names = 1)),
  "cast" = as.matrix(read.delim("out_mRNA/minibulk_SS2_p0/zUMIs_output/allelic/minibulk_p0.CAST_reads.txt", row.names = 1))
)

dat.ae.mb.p0.melt <- dcast(as.data.table(reshape2::melt(ls.ae.mb.p0)), Var1+Var2~L1, value.var="value")
dat.ae.mb.p0.melt[, total := c57+cast]
dat.ae.mb.p0.melt[, ratio := c57/total]
dat.ae.mb.p0.melt[, det := mean(!is.na(ratio)), by="Var1"]
