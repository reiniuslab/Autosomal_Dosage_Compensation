dat.ae.mb.p0.melt[as.data.table(anno.gene), c("chrom", "pos", "gene_name") := list(seqnames, start, gene_name), on = "Var1 == gene_id"]
dat.ae.mb.p0.melt[, pos_10mb := round(pos/10e6)*10e6]

# tpm
mat.tpm.mb.p0 <- fpkm2tpm(loom2matrix("out_mRNA/minibulk_SS2_p0/zUMIs_output/expression/minibulk_p0.rpkm.exon.all.loom"))

mat.tpm.mb.p0.melt <- as.data.table(reshape2::melt(mat.tpm.mb.p0))
mat.tpm.mb.p0.melt[, tpm.avg := mean(value, na.rm=T), by="Var1"]
mat.tpm.mb.p0.melt[anno.cell.mb.p0, c("sample_name", "growth_rate") := list(Sample_name, Growth_rate), on = "Var2 == Barcode"]
mat.tpm.mb.p0.melt[as.data.table(anno.gene), c("chrom", "pos", "gene_name") := list(seqnames, start, gene_name), on = "Var1 == gene_id"]

# allelic tpm
mat.tpm.allelic.mb.p0 <- list(
  "c57" = as.matrix(mat.tpm.mb.p0[row.names(mat.frac.mb.p0),colnames(mat.frac.mb.p0)] * (1 - mat.frac.mb.p0)),
  "cast" = as.matrix(mat.tpm.mb.p0[row.names(mat.frac.mb.p0),colnames(mat.frac.mb.p0)] * mat.frac.mb.p0)
)
mat.tpm.allelic.mb.p0.melt <- as.data.table(reshape2::melt(mat.tpm.allelic.mb.p0))
mat.tpm.allelic.mb.p0.melt[mat.tpm.mb.p0.melt, tpm.avg := tpm.avg, on = c("Var1 == Var1", "Var2 == Var2")]
mat.tpm.allelic.mb.p0.melt[anno.cell.mb.p0, c("sample_name", "growth_rate") := list(Sample_name, Growth_rate), on = "Var2 == Barcode"]
mat.tpm.allelic.mb.p0.melt[as.data.table(anno.gene), c("chrom", "pos", "gene_name") := list(seqnames, start, gene_name), on = "Var1 == gene_id"]
